    <!-- Elementos comunes -->
    <string name="titol_elements_comuns">Interfaz de usuario</string>

    <string name="ajuda_capcalera">En la parte superior de la pantalla tenemos un mensaje de bienvenida y se muestra el correo del usuario. En la parte derecha podemos pulsar sobre el engranaje para acceder a las opciones de información de perfil, selección de idioma, cierre de sesión y ayuda.</string>

    <string name="ajuda_peu">En la parte inferior tenemos el menú de navegación, desde donde podemos acceder a clases, tienda, noticias, calendario y contacto.</string>

    <!-- PROCESO RESERVA -->
    <string name="titol_reserva_classes">Reservar clases</string>

    <string name="ajuda_reserva_acces">Para reservar una clase, tenemos que pulsar en el menú inferior sobre el apartado de clases.</string>

    <string name="ajuda_reserva_filtratge">Dentro de la pantalla de clases podemos filtrar por familias de ejercicios. Al pulsar sobre una de las opciones, aparecen las clases correspondientes a esa familia.</string>

    <string name="ajuda_reserva_seleccio_classes">También es posible seleccionar una clase para poder reservarla. En esta pantalla aparece un listado de las clases disponibles organizadas por fecha y horario. Para reservar, tenemos que buscar la clase que queremos y pulsar sobre el botón “Reservar ahora”.</string>

    <string name="ajuda_reserva_resum_classe">En la pantalla de resumen podemos ver la información de la clase. Aquí tenemos que seleccionar la fecha y la hora que mejor se ajusten a nuestras necesidades y pulsar el botón “Confirmar reserva”.</string>

    <string name="ajuda_reserva_confirmacio">En este paso, la reserva ya está completada.</string>

    <string name="ajuda_reserva_compra_cistella">También es posible comprar productos de la tienda en la cesta de la compra y aquí se puede ver el listado de todos los productos seleccionados</string>


    <!-- PROCESO TIENDA -->
    <string name="titol_compra_botiga">Comprar en la tienda</string>

    <string name="ajuda_botiga_acces">Para comprar en la tienda, tenemos que pulsar en el menú inferior sobre el apartado de tienda.</string>

    <string name="ajuda_botiga_seleccio_producte">Para comprar un producto, tenemos que seleccionar el producto que queremos y pulsar sobre el botón “Comprar ahora”.</string>

    <string name="ajuda_botiga_resum_producte">En la pantalla de resumen del producto seleccionamos la cantidad que queremos comprar. Podemos añadirlo a la cesta para comprar más productos o pulsar directamente en “Pagar ahora”.</string>

    <string name="ajuda_botiga_pagament_producte">En la siguiente pantalla debemos introducir los datos de envío y los datos de la tarjeta para finalizar la compra. Después, hay que pulsar el botón “Pagar ahora”.</string>

    <string name="ajuda_botiga_confirmacio">En este paso, la compra ya está completada.</string>



    <!-- PROCESO NOTICIAS -->
