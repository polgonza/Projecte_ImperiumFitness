    <string name="ajuda_titol">Ajuda</string>
    <string name="ajuda_subtitol">Guia d’ús de l’aplicació</string>

    <!-- Elements comuns -->
    <string name="titol_elements_comuns">Interficie del ususari </string>

    <string name="ajuda_capcalera">A la part superior de la pantalla tenim un missatge de benvinguda i es mostra el correu de l’usuari. A la part dreta podem prémer sobre l’engranatge per accedir a les opcions d’informació de perfil, selecció d’idioma, tancament de sessió i ajuda.</string>

    <string name="ajuda_peu">A la part inferior tenim el menú de navegació, des d’on podem accedir a classes, botiga, notícies, calendari i contacte.</string>

    <!-- PROCÉS RESERVA -->
    <string name="titol_reserva_classes">Reservar classes</string>

    <string name="ajuda_reserva_acces">Per reservar una classe, hem de prémer al menú inferior sobre l’apartat de classes.</string>

    <string name="ajuda_reserva_filtratge">Dins de la pantalla de classes podem filtrar per famílies d’exercicis. En prémer sobre una de les opcions, apareixen les classes corresponents a aquella família.</string>

    <string name="ajuda_reserva_seleccio_classes">També és possible seleccionar una classe per poder reservar-la. En aquesta pantalla apareix un llistat de les classes disponibles organitzades per data i horari. Per reservar, hem de buscar la classe que volem i prémer sobre el botó “Reservar ara”.</string>

    <string name="ajuda_reserva_resum_classe">A la pantalla de resum podem veure la informació de la classe. Aquí hem de seleccionar la data i l’hora que millor s’ajustin a les nostres necessitats i prémer el botó “Confirmar reserva”.</string>

    <string name="ajuda_reserva_confirmacio">En aquest pas, la reserva ja està completada.</string>

    <!-- PROCÉS BOTIGA -->
    <string name="titol_compra_botiga">Comprar a la botiga</string>

    <string name="ajuda_botiga_acces">Per comprar a la botiga, hem de prémer al menú inferior sobre l’apartat de botiga.</string>

    <string name="ajuda_botiga_seleccio_producte">Per comprar un producte, hem de seleccionar el producte que volem i prémer sobre el botó “Comprar ara”.</string>

    <string name="ajuda_botiga_resum_producte">A la pantalla de resum del producte seleccionem la quantitat que volem comprar. Podem afegir-lo a la cistella per comprar més productes o prémer directament “Pagar ara”.</string>

    <string name="ajuda_botiga_pagament_producte">A la pantalla següent hem d’introduir les dades d’enviament i les dades de la targeta per finalitzar la compra. Després, cal prémer el botó “Pagar ara”.</string>

    <string name="ajuda_botiga_confirmacio">En aquest pas, la compra ja està completada.</string>

    <string name="ajuda_reserva_compra_cistella">També es possible comprar productes de la botiga en la cistella de la compra i aquí es poden veure el llistat de tots els productes seleccionats</string>


    <!-- PROCÉS NOTÍCIES -->
    <string name="titol_noticies">Notícies</string>

    <string name="ajuda_noticies_acces">Per consultar les notícies, hem de prémer al menú inferior sobre l’apartat de notícies.</string>

    <!-- PROCÉS CALENDARI -->
    <string name="titol_calendari">Calendari</string>

    <string name="ajuda_calendari_acces">Per consultar el calendari, hem de prémer al menú inferior sobre l’apartat de calendari.</string>

    <string name="ajuda_calendari_seleccio">Per consultar una reserva al calendari, hem de prémer sobre el dia en què tenim una reserva. A continuació, apareixerà la informació de la classe reservada.</string>

    <!-- PROCÉS CONTACTE -->
    <string name="titol_contacte">Contacte</string>

    <string name="ajuda_contacte_acces">Per accedir a la pàgina de contacte amb el gimnàs, hem de prémer al menú inferior sobre l’apartat de contacte.</string>

    <string name="ajuda_contacte_missatge">Per posar-te en contacte amb nosaltres, només has de prémer el botó “Envia’ns un missatge” i automàticament s’obrirà el correu electrònic per escriure el teu missatge.</string>

