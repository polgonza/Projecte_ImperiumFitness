    <string name="ajuda_titol">Help</string>
    <string name="ajuda_subtitol">Application user guide</string>

    <!-- Common elements -->
    <string name="titol_elements_comuns">User interface</string>

    <string name="ajuda_capcalera">At the top of the screen there is a welcome message and the user’s email address is shown. On the right side, the user can tap the gear icon to access the profile information, language selection, log out and help options.</string>

    <string name="ajuda_peu">At the bottom of the screen there is a navigation menu, where the user can access classes, shop, news, calendar and contact.</string>

    <!-- BOOKING PROCESS -->
    <string name="titol_reserva_classes">Booking classes</string>

    <string name="ajuda_reserva_acces">To book a class, the user must tap the classes section in the bottom menu.</string>

    <string name="ajuda_reserva_filtratge">Inside the classes screen, the user can filter by exercise families. When tapping one of the options, the classes related to that family are displayed.</string>

    <string name="ajuda_reserva_seleccio_classes">It is also possible to select a class in order to book it. This screen shows a list of available classes organised by date and time. To book, the user must find the class they want and tap the “Book now” button.</string>

    <string name="ajuda_reserva_resum_classe">On the summary screen, the user can see the class information. Here, they must select the date and time that best suit their needs and tap the “Confirm booking” button.</string>

    <string name="ajuda_reserva_confirmacio">At this step, the booking is completed.</string>

    <!-- SHOP PROCESS -->
    <string name="titol_compra_botiga">Buying from the shop</string>

    <string name="ajuda_botiga_acces">To buy from the shop, the user must tap the shop section in the bottom menu.</string>

    <string name="ajuda_botiga_seleccio_producte">To buy a product, the user must select the product they want and tap the “Buy now” button.</string>

    <string name="ajuda_botiga_resum_producte">On the product summary screen, the user selects the quantity they want to buy. They can add it to the cart to buy more products or tap “Pay now” directly.</string>

    <string name="ajuda_botiga_pagament_producte">On the next screen, the user must enter the shipping details and card details to complete the purchase. Then, they must tap the “Pay now” button.</string>

    <string name="ajuda_botiga_confirmacio">In these steps, the purchase is completed.</string>

    <string name="ajuda_reserva_compra_cistella">Is posible too buy products from the shop in the cart, and see the list of all the products was chosed</string>
    <!-- NEWS PROCESS -->
    <string name="titol_noticies">News</string>

    <string name="ajuda_noticies_acces">To view the news, the user must tap the news section in the bottom menu.</string>

    <!-- CALENDAR PROCESS -->
    <string name="titol_calendari">Calendar</string>

    <string name="ajuda_calendari_acces">To view the calendar, the user must tap the calendar section in the bottom menu.</string>

    <string name="ajuda_calendari_seleccio">To check a booking in the calendar, the user must tap the day on which they have a booking. The information about the booked class will then appear.</string>

    <!-- CONTACT PROCESS -->
    <string name="titol_contacte">Contact</string>

    <string name="ajuda_contacte_acces">To access the gym contact page, the user must tap the contact section in the bottom menu.</string>

    <string name="ajuda_contacte_missatge">To contact us, the user only has to tap the “Send us a message” button and the email application will automatically open so they can write their message.</string>
