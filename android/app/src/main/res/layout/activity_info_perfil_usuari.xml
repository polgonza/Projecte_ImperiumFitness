<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2B2B2B">

    <!-- TOPBAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#555555"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAccountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_titol"
                android:textColor="#F0DB1A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAccountSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_subtitol"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#7B2CFF"
            android:clickable="true"
            android:focusable="true"
            android:onClick="toggleDrawer"
            android:padding="2dp">

            <ImageView
                android:id="@+id/imgTopLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#555555"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/logo" />
        </FrameLayout>
    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- NOM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_nom"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/etNom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:inputType="text" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_email"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/etEmailUsuari"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:inputType="textEmailAddress" />

            <!-- PLA ACTUAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pla actual"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/etPlaActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:enabled="false"
                android:textColor="#000000"
                android:inputType="text" />

            <!-- CONTRASENYA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil_contrasenya"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="6dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="textPassword"
                    android:background="@android:color/transparent"
                    android:padding="10dp" />

                <ImageButton
                    android:id="@+id/btnMostrarPassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/perfil_mostrar_contrasenya" />
            </LinearLayout>

            <!-- BOTONES -->
            <Button
                android:id="@+id/btnGuardarCanvis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualitzar dades"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FFC107"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCanviarPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perfil_canviar_contrasenya"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#D0D0D0"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:weightSum="6">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/home"
                android:contentDescription="@string/nav_inici" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_inici"
                android:textColor="#333333"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navClasses"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/classes"
                android:contentDescription="@string/nav_classes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_classes"
                android:textColor="#333333"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBotiga"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/shop"
                android:contentDescription="@string/nav_botiga" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_botiga"
                android:textColor="#333333"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navNoticies"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/noticies"
                android:contentDescription="@string/nav_noticies" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_noticies"
                android:textColor="#333333"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendari"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/calendari"
                android:contentDescription="@string/nav_calendari" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_calendari"
                android:textColor="#333333"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navContacte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/contacte"
                android:contentDescription="@string/nav_contacte" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_contacte"
                android:textColor="#333333"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>