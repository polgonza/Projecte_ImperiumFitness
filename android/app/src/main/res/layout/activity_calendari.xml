<?xml version="1.0" encoding="utf-8"?>
<!--
    ACTIVITY_CALENDARI.XML
    Pantalla que mostra un calendari mensual.
    Els dies en què l'usuari té classes reservades apareixeran ressaltats (en el futur, amb base de dades).
    L'usuari pot seleccionar un dia per veure les reserves d'aquell dia.
    Té topbar amb títol i subtítol, i bottom navigation amb 6 ítems.
    En el futur, es connectarà a la base de dades per obtenir les reserves de l'usuari.
-->
<LinearLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2B2B2B">

    <!-- TOPBAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#555555"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCalendariTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calendari_titol"
                android:textColor="#F0DB1A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCalendariSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calendari_subtitol"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#7B2CFF"
            android:clickable="true"
            android:focusable="true"
            android:onClick="toggleDrawer"
            android:padding="2dp">

            <ImageView
                android:id="@+id/imgTopLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#555555"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/logo" />
        </FrameLayout>
    </LinearLayout>

    <!-- ZONA CENTRAL: Calendari personalitzat + resum -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Navegació de mes: fletxa esquerra, mes/any, fletxa dreta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnMesAnterior"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="‹"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#555555"
                android:padding="0dp" />

            <TextView
                android:id="@+id/tvMesAny"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#F0DB1A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMesSeguent"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="›"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#555555"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Capçalera dies de la setmana -->
        <LinearLayout
            android:id="@+id/llDiesSetmana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- Es genera des de Java -->
        </LinearLayout>

        <!-- Graella de dies del mes (7 columnes x 6 files màxim) -->
        <GridLayout
            android:id="@+id/gridDies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7"
            android:layout_marginBottom="12dp" />

        <!-- Llegenda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="#F0DB1A"
                android:layout_marginEnd="6dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dia amb reserva"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:layout_marginEnd="20dp" />

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="#7B2CFF"
                android:layout_marginEnd="6dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avui"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Resum: propera reserva -->
        <LinearLayout
            android:id="@+id/llResumReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#555555"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvProperaReserva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregant reserves..."
                android:textColor="#F0DB1A"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#D0D0D0"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:weightSum="6">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/home" android:contentDescription="@string/nav_inici" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_inici" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navClasses"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/classes" android:contentDescription="@string/nav_classes" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_classes" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBotiga"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/shop" android:contentDescription="@string/nav_botiga" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_botiga" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navNoticies"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/noticies" android:contentDescription="@string/nav_noticies" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_noticies" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendari"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/calendari" android:contentDescription="@string/nav_calendari" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_calendari" android:textColor="#111111" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navContacte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/contacte" android:contentDescription="@string/nav_contacte" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_contacte" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>