<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#555555"
    android:layout_marginBottom="4dp">

    <ImageView
        android:id="@+id/ivImatge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/producto_2"
        android:contentDescription="@string/producte_camiseta" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/tvNomProducte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/producte_camiseta"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvPreuProducte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/producte_preu_camiseta"
            android:textColor="#E6D91C"
            android:textSize="12sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnEliminar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="X"
        android:backgroundTint="#F44336"
        android:textColor="#FFFFFF"/>
</LinearLayout>