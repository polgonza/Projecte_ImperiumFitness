<?xml version="1.0" encoding="utf-8"?>
<!--
    ACTIVITY_MAIN_INICI.XML
    Pantalla principal de l'aplicació (splash/landing).
    Mostra el logo, el títol i dos botons per iniciar sessió o registrar-se.
    No té bottom navigation ni topbar perquè és la pantalla d'entrada abans de loguejar-se.
    En el futur, quan l'usuari iniciï sessió, es guardarà l'estat per redirigir a Home.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FONS: imatge de fons del gimnàs -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/imagenfondo"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ombra fosca sobre el fons per millorar la llegibilitat del text -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contingut principal centrat verticalment i horitzontalment -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo del gimnàs -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Títol de l'aplicació -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/main_titol"
            android:textColor="#D4AF37"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo" />

        <!-- Botó per anar a la pantalla d'inici de sessió -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciaSessio"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/btn_inicia_sessio"
            android:textAllCaps="false"
            android:textColor="#F4D000"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="8dp"
            app:strokeColor="#F4D000"
            app:strokeWidth="2dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botó per anar a la pantalla de registre -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistre"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/btn_registre"
            android:textAllCaps="false"
            android:textColor="#F4D000"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="8dp"
            app:strokeColor="#F4D000"
            app:strokeWidth="2dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnIniciaSessio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>