<?xml version="1.0" encoding="utf-8"?>
<!--
    ACTIVITY_BOTIGA.XML
    Pantalla que mostra tots els productes de la botiga.
    Cada producte es mostra dins d'un CardView amb un botó "Compra ara".
    En clicar el botó, s'obre la pantalla ProductesBotiga amb el detall d'aquest producte.
    Té topbar amb títol, subtítol, icona de cistella (per veure la cistella) i bottom navigation amb 6 ítems.

    PRODUCTES DISPONIBLES:
    - Producte 1: Proteïna (39,99€)
    - Producte 2: Camiseta (19,99€)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9D9D9">

    <!-- ==================== CAPÇALERA SUPERIOR (TOPBAR) ==================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="#555555"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStoreTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/botiga_titol"
                android:textColor="#F0DB1A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStoreSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/botiga_subtitol"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ICONA DE LA CISTELLA - ACCÉS DIRECTE A LA CISTELLA -->
        <LinearLayout
            android:id="@+id/llCistella"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivCistella"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/cistella"
                android:contentDescription="@string/botiga_cistella" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/botiga_cistella"
                android:textColor="#F0DB1A"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Logo/Icona de perfil clicable -->
        <FrameLayout
            android:id="@+id/logoContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#7B2CFF"
            android:clickable="true"
            android:focusable="true"
            android:onClick="toggleDrawer"
            android:padding="2dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/imgTopLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#555555"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/logo" />
        </FrameLayout>
    </LinearLayout>

    <!-- ==================== ZONA CENTRAL DESPLAÇABLE ==================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProducts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== PRODUCTE 1: PROTEÏNA ==================== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProduct1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#8E8E8E"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgProduct1"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="14dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/proteina"
                        android:contentDescription="@string/producte_proteina" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/producte_proteina"
                            android:textColor="#F5F5F5"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/producte_preu_proteina"
                            android:textColor="#F5F5F5"
                            android:textSize="16sp"
                            android:layout_marginTop="4dp" />

                        <Button
                            android:id="@+id/btnComprar1"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_comprar_ara"
                            android:backgroundTint="#FFC107"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ==================== PRODUCTE 2: CAMISETA ==================== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProduct2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#8E8E8E"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgProduct2"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="14dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/camiseta"
                        android:contentDescription="@string/producte_camiseta" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/producte_camiseta"
                            android:textColor="#F5F5F5"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/producte_preu_camiseta"
                            android:textColor="#F5F5F5"
                            android:textSize="16sp"
                            android:layout_marginTop="4dp" />

                        <Button
                            android:id="@+id/btnComprar2"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_comprar_ara"
                            android:backgroundTint="#FFC107"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ==================== FOOTER (BOTTOM NAVIGATION) ==================== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#D0D0D0"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/home" android:contentDescription="@string/nav_inici" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_inici" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navClasses"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/classes" android:contentDescription="@string/nav_classes" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_classes" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBotiga"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/shop" android:contentDescription="@string/nav_botiga" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_botiga" android:textColor="#111111" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navNoticies"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/noticies" android:contentDescription="@string/nav_noticies" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_noticies" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendari"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/calendari" android:contentDescription="@string/nav_calendari" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_calendari" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navContacte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/contacte" android:contentDescription="@string/nav_contacte" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/nav_contacte" android:textColor="#333333" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>